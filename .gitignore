# Rust build artifacts
/target
**/*.rs.bk

# Cargo.lock IS committed for this workspace (reproducible builds, NFR7).
# Do NOT add Cargo.lock here.

# Tool output — never commit triage results (incl. live-run dirs like out-live/).
# Live runs capture real host process/network state; these must never be committed.
/out
/out-*
/test-data

# Forensic fixtures & sample evidence — kept out of git (size + sensitivity).
# The full EVTX-ATTACK-SAMPLES corpus stays out (fetched for parity work, T8).
*.evtx
*.zip
*.hve
*.dat
*.bad
/tests/samples/
/tests/EVTX-ATTACK-SAMPLES/
# The real-sample EVTX fixtures are GPL-3.0 and are NOT committed: tests/fetch-fixtures.sh
# downloads them and checks tests/fixtures/SHA256SUMS (CI runs it before the tests).
# Only the README (sources) and the checksums are tracked.
/tests/fixtures/*
!/tests/fixtures/README.md
!/tests/fixtures/SHA256SUMS

# Machine-specific cargo target-dir override. The committed .cargo/config.toml contains
# cross-machine settings (CRT static link rustflags). The target-dir line in that file is
# a sensible default; override with CARGO_TARGET_DIR env var on other machines.
# See CLAUDE.md "Local dev environment notes".

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# Local debug artifacts — real host prefetch files, never commit
*.pf
sample.pf
